<resources>
    <!-- Window theme behind the Compose UI. Compose draws everything; this only sets the window background,
         so the platform theme is enough (no Material Components dependency). -->
    <style name="Theme.Edith" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/edith_background_light</item>
    </style>

    <style name="Theme.Edith.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/edith_purple</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Edith</item>
    </style>
</resources>
