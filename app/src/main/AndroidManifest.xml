<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- C03: Ollama client needs network access (cleartext HTTP to the owner's PC) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 (targetSdk 37) blocks connections to the local network (the owner's PC, incl. the emulator's
         10.0.2.2) unless the user grants this runtime permission; without it requests just time out.
         C04 asks for it before connecting (04-lessons L23). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- D13 / L24: a short foreground service keeps a reply's connection alive after the owner leaves the app
         ("shortService" needs no type-specific permission). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Lets the "Edith is replying…" notification show (Android 13+); asked on the first Send (D13). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- C11: approximate location for "here", asked the first time it's needed. Never fine or background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- C12: voice memos and dictation, asked the first time either button is used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- C14: hands-free listens in a microphone foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- C12: Android 11+ hides the speech recognizer service from apps that don't declare it here. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- C13: without it Android 11+ hides the text-to-speech engines, and Edith can't speak. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".EdithApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Edith.Splash">

        <!-- singleTask (C17b §4): Chrome's "Back to Edith" link must bring back the running activity. With the default
             launch mode Android finished it and started a new one on the Chat tab, losing Settings and its
             sign-in dialog (seen on the emulator, 2026-11-11). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- C17b §4: the browser sign-in page's "Back to Edith" link (`<applicationId>://signed-in`). It only
                 brings Edith forward; it carries no code (that arrives on the loopback listener). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="signed-in" />
            </intent-filter>
        </activity>

        <service
            android:name=".chat.service.ReplyService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
        <!-- C14: hands-free listening, only while its notification shows. -->
        <service
            android:name=".voice.handsfree.HandsFreeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- C16: Share on Edith's file cards. Only cacheDir/share (copies made to share) is exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
