<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- C03: Ollama client needs network access (cleartext HTTP to the owner's PC) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 (targetSdk 37) blocks connections to the local network (the owner's PC, incl. the emulator's
         10.0.2.2) unless the user grants this runtime permission; without it requests just time out.
         C04 asks for it before connecting (04-lessons L23). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- D13 / L24: a short foreground service keeps a reply's connection alive after the owner leaves the app
         ("shortService" needs no type-specific permission). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Lets the "Edith is replying…" notification show (Android 13+); asked on the first Send (D13). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".EdithApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Edith.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".chat.service.ReplyService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>
</manifest>
