<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets a developer crash Edith on purpose to test crash reports (C02 acceptance):
     adb shell am start -a com.edith.app.DEBUG_CRASH -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".debug.DebugCrashActivity"
            android:exported="true"
            android:theme="@style/Theme.Edith">
            <intent-filter>
                <action android:name="com.edith.app.DEBUG_CRASH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- C12: send a pushed WAV as a voice memo (see DebugVoiceMemoReceiver). DUMP: only the shell may send it. -->
        <receiver
            android:name=".debug.DebugVoiceMemoReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- C14: feed hands-free a wake-word WAV and a sentence (see DebugHandsFreeReceiver). DUMP: only the shell may send it. -->
        <receiver
            android:name=".debug.DebugHandsFreeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- C17: get a Calendar token and make one request (see DebugGoogleReceiver). DUMP: only the shell may send it. -->
        <receiver
            android:name=".debug.DebugGoogleReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- C23: a few timed Graph requests for each Microsoft account (see DebugMicrosoftReceiver). DUMP: only the shell may send it. -->
        <receiver
            android:name=".debug.DebugMicrosoftReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- C33: switch the Demo doorbell's alerts on or off, or ring it (see DebugAlertReceiver). DUMP: only the shell may send it. -->
        <receiver
            android:name=".debug.DebugAlertReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
